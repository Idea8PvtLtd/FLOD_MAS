// Colour key used by every diagram of the handbook.
digraph G {
  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", nodesep=0.28, ranksep=0.38, pad=0.1];
  node  [fontname="Liberation Sans", fontsize=10.5, shape=box, style="rounded,filled", fillcolor="white", color="#5a6577", penwidth=0.9, margin="0.12,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#5a6577", arrowsize=0.7, penwidth=0.9];
  rankdir=LR; nodesep=0.15; node [height=0.34];
  a [label="inspection app code", fillcolor="#DCE8F7"];
  b [label="research code and tools", fillcolor="#DDF0DD"];
  c [label="colleague's code on main", fillcolor="#E8DDF5"];
  d [label="outside this PC", fillcolor="#FBE3C8"];
  e [label="file or data", fillcolor="#EEEEEE", shape=note, style=filled];
  f [label="decision or check", fillcolor="#FFF3BF", shape=diamond, style=filled, margin="0.02,0.02"];
  a -> b -> c [style=invis]; d -> e -> f [style=invis];
}
