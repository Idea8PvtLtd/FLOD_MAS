// Width in millimetres and the test for width changes (segmentation/width_stats.py, tools/width_report.py).
digraph G {
  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", nodesep=0.28, ranksep=0.38, pad=0.1];
  node  [fontname="Liberation Sans", fontsize=10.5, shape=box, style="rounded,filled", fillcolor="white", color="#5a6577", penwidth=0.9, margin="0.12,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#5a6577", arrowsize=0.7, penwidth=0.9];
  rankdir=TB;
  m [label="Mask probability + line course", shape=note, style=filled, fillcolor="#EEEEEE"];
  w [label="Width every 2 px: where the probability crosses 0.5\non each side (between pixels); 60 px left out at each tip\nsegformer_local.mask_edges", fillcolor="#DDF0DD"];
  s [label="Pixels to mm: scale surface fitted over the frame\n(quadratic, one factor per colour, robust),\ngood lines taken to average 4 mm\nwidth_stats.fit_scale", fillcolor="#DDF0DD"];
  t [label="Departure = width - the line's own gradual course\n(robust quadratic)   width_stats.slow_trend", fillcolor="#DDF0DD"];
  win [label="Average the departure over windows of\n40, 80, 160 and 320 px", fillcolor="#DDF0DD"];
  lim [label="Limits from good lines of other frames: largest window\nmean of each line, all window lengths together;\n95th percentile = significant, 80th = notable\nwidth_stats.limits_from_good_lines", fillcolor="#DDF0DD"];
  over [label="Any window over\nits limit?", shape=diamond, style=filled, fillcolor="#FFF3BF", margin="0.02,0.02"];
  none [label="No finding", shape=note, style=filled, fillcolor="#EEEEEE"];
  g [label="Mask in doubt over 30 % of the stretch?\n(no mask | fading edge | sideways step)", shape=diamond, style=filled, fillcolor="#FFF3BF", margin="0.02,0.02"];
  b [label="Band edges change the same way,\nat least half as much?", shape=diamond, style=filled, fillcolor="#FFF3BF", margin="0.02,0.02"];
  r1 [label="glitch", fillcolor="#FFE08A"]; r2 [label="confirmed by\nthe band edges", fillcolor="#BFE3C0"]; r3 [label="mask only", fillcolor="#EEEEEE"];
  m -> w -> s -> t -> win -> over; lim -> over;
  over -> none [label="no"]; over -> g [label="yes"]; g -> r1 [label="yes"]; g -> b [label="no"]; b -> r2 [label="yes"]; b -> r3 [label="no"];
}
