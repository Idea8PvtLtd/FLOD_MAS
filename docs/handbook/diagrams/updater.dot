// The updater on main (updater/updater.py), read from the source and not run.
digraph G {
  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", nodesep=0.28, ranksep=0.38, pad=0.1];
  node  [fontname="Liberation Sans", fontsize=10.5, shape=box, style="rounded,filled", fillcolor="white", color="#5a6577", penwidth=0.9, margin="0.12,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#5a6577", arrowsize=0.7, penwidth=0.9];
  rankdir=TB;
  s [label="App Starter window (CustomTkinter)", fillcolor="#E8DDF5"];
  net [label="github.com reachable?", shape=diamond, style=filled, fillcolor="#FFF3BF", margin="0.02,0.02"];
  old [label="Launch the existing release", fillcolor="#E8DDF5"];
  fetch [label="Fetch branch main into a bare mirror (repo.git)", fillcolor="#E8DDF5"];
  new [label="New commit?", shape=diamond, style=filled, fillcolor="#FFF3BF", margin="0.02,0.02"];
  ext [label="Extract the commit into releases/<sha>", fillcolor="#E8DDF5"];
  req [label="requirements.txt changed?\ninstall into the venv (Python 3.12)", fillcolor="#E8DDF5"];
  prune [label="Keep the 3 newest releases", fillcolor="#E8DDF5"];
  run [label="Stop the running app, launch main_1366.py\nfrom the new release", fillcolor="#E8DDF5"];
  loop [label="Starter closes itself after 1.5 s\n(checks once per start)", fillcolor="#EEEEEE"];
  s -> net; net -> old [label="no"]; net -> fetch [label="yes"]; fetch -> new; new -> old [label="no"]; new -> ext [label="yes"];
  ext -> req -> prune -> run -> loop; old -> loop;
}
