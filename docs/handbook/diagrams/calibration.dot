// Calibration and the millimetre scale (CalibrateAPP/, plane_scale.py).
digraph G {
  graph [fontname="Liberation Sans", fontsize=11, bgcolor="white", nodesep=0.28, ranksep=0.38, pad=0.1];
  node  [fontname="Liberation Sans", fontsize=10.5, shape=box, style="rounded,filled", fillcolor="white", color="#5a6577", penwidth=0.9, margin="0.12,0.07"];
  edge  [fontname="Liberation Sans", fontsize=9, color="#5a6577", arrowsize=0.7, penwidth=0.9];
  rankdir=TB;
  board [label="ChArUco board, about twenty views\n(one board, or two numbered boards)", shape=note, style=filled, fillcolor="#EEEEEE"];
  intr [label="Intrinsics: camera matrix and\nlens distortion (calibrateCamera)", fillcolor="#DCE8F7"];
  chk1 [label="Reprojection error acceptable?", shape=diamond, style=filled, fillcolor="#FFF3BF", margin="0.02,0.02"];
  surf [label="Board flat on the measurement surface:\npose by solvePnP (IPPE, refined)", fillcolor="#DCE8F7"];
  chk2 [label="Pose error <= 1.5 px RMS?", shape=diamond, style=filled, fillcolor="#FFF3BF", margin="0.02,0.02"];
  files [label="Saved calibration and extrinsics files", shape=note, style=filled, fillcolor="#EEEEEE"];
  und [label="Runtime: ImageUndistorter\nremoves lens distortion", fillcolor="#DCE8F7"];
  plane [label="Runtime: plane_scale.load_frame_scale\npixel -> ray -> point on the plane (mm)", fillcolor="#DCE8F7"];
  use [label="Width = distance in mm between\nthe two mapped edge points", fillcolor="#DCE8F7"];
  alt [label="Alternative modes: ArUco marker in every\nframe; region homography (optional)", fillcolor="#EEEEEE"];
  board -> intr -> chk1; chk1 -> surf [label="yes"]; chk1 -> board [label="no: retake", constraint=false];
  surf -> chk2; chk2 -> files [label="yes"]; chk2 -> surf [label="no: retake", constraint=false];
  files -> und; files -> plane; und -> plane -> use; alt -> plane [style=dashed];
}
