// Module architecture of the inspection application on tooling/pipeline-lab, by layer.
// Each layer is one node whose label is a table. An arrow means "calls" or "passes to".
digraph G {
  graph [fontname="Liberation Sans", bgcolor="white", ranksep=0.34, pad=0.1];
  node  [fontname="Liberation Sans", fontsize=9.5, shape=plain];
  edge  [fontname="Liberation Sans", fontsize=9, color="#5a6577", arrowsize=0.7, penwidth=0.9];
  rankdir=TB;
  L0 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="4" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Window (Tk main thread)</B></FONT></TD></TR><TR><TD BGCOLOR="#DCE8F7" WIDTH="120" HEIGHT="36"><B>startup_settings.py</B><BR/><FONT POINT-SIZE="8.5">countdown, settings form</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="120" HEIGHT="36"><B>main_1366.py</B><BR/><FONT POINT-SIZE="8.5">IndustrialDashboard</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="120" HEIGHT="36"><B>inspection/dashboard.py</B><BR/><FONT POINT-SIZE="8.5">AutomaticDashboard</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="120" HEIGHT="36"><B>inspection/result_view.py</B><BR/><FONT POINT-SIZE="8.5">FabricResultView</FONT></TD></TR></TABLE>>];
  L1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="3" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Trigger: auto_trigger/ (its own thread)</B></FONT></TD></TR><TR><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>controller.py</B><BR/><FONT POINT-SIZE="8.5">AutoController</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>checkpoint.py</B><BR/><FONT POINT-SIZE="8.5">Checkpoint, Debouncer</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>models.py</B><BR/><FONT POINT-SIZE="8.5">HandPresence, FabricGate</FONT></TD></TR></TABLE>>];
  L2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>One capture: inspection/ (a thread per capture)</B></FONT></TD></TR><TR><TD BGCOLOR="#DCE8F7" WIDTH="240" HEIGHT="36"><B>pipeline.py</B><BR/><FONT POINT-SIZE="8.5">InspectionPipeline</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="240" HEIGHT="36"><B>storage.py</B><BR/><FONT POINT-SIZE="8.5">CaptureStore</FONT></TD></TR></TABLE>>];
  L3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="4" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Segmentation: segmentation/</B></FONT></TD></TR><TR><TD BGCOLOR="#DCE8F7" WIDTH="120" HEIGHT="36"><B>__init__.py</B><BR/><FONT POINT-SIZE="8.5">create_segmenter, contract</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="120" HEIGHT="36"><B>provider.py + workflow/</B><BR/><FONT POINT-SIZE="8.5">cloud workflow (default)</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="120" HEIGHT="36"><B>glue_line.py</B><BR/><FONT POINT-SIZE="8.5">local detector (opt-in)</FONT></TD><TD BGCOLOR="#FBE3C8" WIDTH="120" HEIGHT="36"><B>Roboflow cloud</B><BR/><FONT POINT-SIZE="8.5">image uploaded</FONT></TD></TR></TABLE>>];
  L4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="3" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Measurement</B></FONT></TD></TR><TR><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>inspection/measurement.py</B><BR/><FONT POINT-SIZE="8.5">measure_instances</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>sam_detection.py</B><BR/><FONT POINT-SIZE="8.5">analyse, draw, record</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>strip_analysis.py</B><BR/><FONT POINT-SIZE="8.5">centreline, widths, grade</FONT></TD></TR></TABLE>>];
  L5 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="3" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Scale and calibration</B></FONT></TD></TR><TR><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>plane_scale.py</B><BR/><FONT POINT-SIZE="8.5">pixels to millimetres</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>CalibrateAPP/</B><BR/><FONT POINT-SIZE="8.5">calibration windows, maths</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>measure/</B><BR/><FONT POINT-SIZE="8.5">undistort, ArUco plane</FONT></TD></TR></TABLE>>];
  L6 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="3" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Camera and settings</B></FONT></TD></TR><TR><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>camera_handler.py</B><BR/><FONT POINT-SIZE="8.5">CameraStream, CameraHandler</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>app_config.py</B><BR/><FONT POINT-SIZE="8.5">CONFIG, paths</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="160" HEIGHT="36"><B>config_validation.py</B><BR/><FONT POINT-SIZE="8.5">checks at start</FONT></TD></TR></TABLE>>];
  L0 -> L1 [label="  frames in, events out"];
  L1 -> L2 [label="  run(snapshot)"];
  L2 -> L3 [label="  segment(frame)"];
  L3 -> L4 [label="  polygons in frame pixels"];
  L4 -> L5 [label="  widths in pixels -> mm"];
  L5 -> L6 [label="  (read by every layer above)", style=dashed];
}
