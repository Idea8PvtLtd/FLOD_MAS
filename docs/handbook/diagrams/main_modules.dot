// Modules added, changed or replaced on main (read at commit 485c4b6), by layer.
// Each layer is one node whose label is a table. An arrow means "calls" or "passes to".
digraph G {
  graph [fontname="Liberation Sans", bgcolor="white", ranksep=0.34, pad=0.1];
  node  [fontname="Liberation Sans", fontsize=9.5, shape=plain];
  edge  [fontname="Liberation Sans", fontsize=9, color="#5a6577", arrowsize=0.7, penwidth=0.9];
  rankdir=TB;
  L0 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="4" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Start and window</B></FONT></TD></TR><TR><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>updater/updater.py</B><BR/><FONT POINT-SIZE="8.5">new: fetch, install, launch</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>main_1366.py</B><BR/><FONT POINT-SIZE="8.5">changed</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>inspection/dashboard.py</B><BR/><FONT POINT-SIZE="8.5">changed: pause, reset, overlay</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>developer_controls.py</B><BR/><FONT POINT-SIZE="8.5">new: ratio editor</FONT></TD></TR></TABLE>>];
  L1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="3" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Trigger: auto_trigger/</B></FONT></TD></TR><TR><TD BGCOLOR="#E8DDF5" WIDTH="160" HEIGHT="36"><B>controller.py</B><BR/><FONT POINT-SIZE="8.5">changed: FIFO queue, lines done</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="160" HEIGHT="36"><B>bed_markers.py</B><BR/><FONT POINT-SIZE="8.5">new: two ArUco ID-0 markers</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="160" HEIGHT="36"><B>models.py</B><BR/><FONT POINT-SIZE="8.5">changed: 2-class fabric gate</FONT></TD></TR></TABLE>>];
  L2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="3" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>One capture: inspection/</B></FONT></TD></TR><TR><TD BGCOLOR="#E8DDF5" WIDTH="160" HEIGHT="36"><B>pipeline.py</B><BR/><FONT POINT-SIZE="8.5">replaced: run, run_batch</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="160" HEIGHT="36"><B>overlay.py</B><BR/><FONT POINT-SIZE="8.5">new: mask tint, joins, labels</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="160" HEIGHT="36"><B>storage.py</B><BR/><FONT POINT-SIZE="8.5">changed: mask, overlay, line_N</FONT></TD></TR></TABLE>>];
  L3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="4" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Detection: inspection/local/ (all new)</B></FONT></TD></TR><TR><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>engine.py</B><BR/><FONT POINT-SIZE="8.5">LiveInspection</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>source_model.py</B><BR/><FONT POINT-SIZE="8.5">strip U-Net (ONNX)</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>geometry.py</B><BR/><FONT POINT-SIZE="8.5">band, unfold, refold</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>glue_model.py</B><BR/><FONT POINT-SIZE="8.5">SegFormer-B0 (ONNX)</FONT></TD></TR></TABLE>>];
  L4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="4" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Measurement</B></FONT></TD></TR><TR><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>local/width_measurement.py</B><BR/><FONT POINT-SIZE="8.5">new: ray widths</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>inspection/line_measurement.py</B><BR/><FONT POINT-SIZE="8.5">new: ends, mm, segments</FONT></TD><TD BGCOLOR="#E8DDF5" WIDTH="120" HEIGHT="36"><B>measurement_adjustment.py</B><BR/><FONT POINT-SIZE="8.5">new: user ratio</FONT></TD><TD BGCOLOR="#DCE8F7" WIDTH="120" HEIGHT="36"><B>plane_scale.py</B><BR/><FONT POINT-SIZE="8.5">unchanged</FONT></TD></TR></TABLE>>];
  L5 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#5a6577"><TR><TD COLSPAN="3" BORDER="0" ALIGN="LEFT"><FONT COLOR="#5a6577" POINT-SIZE="9"><B>Still in the repository, no longer called by the automatic flow</B></FONT></TD></TR><TR><TD BGCOLOR="#EEEEEE" WIDTH="160" HEIGHT="36"><B>segmentation/</B><BR/><FONT POINT-SIZE="8.5">providers</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="160" HEIGHT="36"><B>inspection/measurement.py</B><BR/><FONT POINT-SIZE="8.5">per-fabric measurement</FONT></TD><TD BGCOLOR="#EEEEEE" WIDTH="160" HEIGHT="36"><B>sam_detection.py</B><BR/><FONT POINT-SIZE="8.5">analyze_detection</FONT></TD></TR></TABLE>>];
  L0 -> L1 [label="  frames in, events out"];
  L1 -> L2 [label="  run_batch(snapshot)"];
  L2 -> L3 [label="  run_lines(photo)"];
  L3 -> L4 [label="  mask and samples per line"];
  L4 -> L5 [label="  (replaced by the two layers above)", style=dashed];
}
